                        "type": "integer",
                        "description": "최대 가격",
                        "name": "max_price",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "최소 연도",
                        "name": "min_year",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "최대 연도",
                        "name": "max_year",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "정렬 (price_asc, price_desc, year_asc, year_desc, created_at_asc, created_at_desc)",
